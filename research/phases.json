      "name": "Research constitution and scope freeze",
      "status": "complete",
      "command": "cargo run -p zerolm-policy --bin zerolm-audit -- --json",
      "report_schema": "research/schemas/phase0-report.schema.json"
    },
    {
      "id": 1,
      "name": "Freeze and audit the baseline",
      "status": "complete",
