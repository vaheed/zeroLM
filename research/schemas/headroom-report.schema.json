{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZeroLM novelty experiment N0: match-prior headroom over count models (reports/headroom/summary.json)",
  "type": "object",
  "required": ["report", "split_role", "mixer", "exposure_sha256", "manifest_sha256", "min_len", "rows", "scope_note"],
  "properties": {
    "report": {"const": "headroom"},
    "split_role": {"enum": ["dev", "hidden"]},
    "mixer": {"enum": ["v1", "v2"]},
    "exposure_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "min_len": {"type": "integer", "minimum": 1},
    "rows": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["exposure_bytes", "role", "history", "count_model", "heldout_bytes", "base_bpb", "with_match_bpb", "gain_bpb", "gain_ci95"]}},
    "scope_note": {"type": "string"}
  }
}
