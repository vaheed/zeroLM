{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZeroLM audit report",
  "type": "object",
  "required": ["report", "passed", "checks_run", "violations"],
  "properties": {
    "report": {"const": "audit"},
    "passed": {"type": "boolean"},
    "checks_run": {"type": "array", "items": {"type": "string"}},
    "violations": {"type": "array", "items": {"type": "object", "required": ["check", "detail"], "properties": {"check": {"type": "string"}, "detail": {"type": "string"}}}}
  }
}
