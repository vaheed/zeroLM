{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZeroLM experiment GDM: compiled gated-delta memory against random initialization (reports/gdm-*/summary.json)",
  "type": "object",
  "required": [
    "report", "phase", "role", "verdict", "seeds", "exposure_bytes", "heldout_bytes_per_role",
    "manifest_sha256", "exposure_fiction_sha256", "exposure_wiki_sha256", "heldout_sha256", "spec_sha256",
    "gru_budget", "selection", "chosen", "jobs", "contrasts", "instrument_validation", "probe_valid",
    "lr_equal_c1", "rules", "ci_note", "scope_note"
  ],
  "properties": {
    "report": {"const": "gdm"},
    "phase": {"enum": ["screening", "confirmatory"]},
    "role": {"enum": ["dev", "hidden"]},
    "verdict": {"enum": ["PASS", "PIVOT", "FAIL", "NOT CONFIRMATORY (screening)"]},
    "seeds": {"type": "array", "items": {"type": "integer"}, "minItems": 2},
    "jobs": {"type": "array", "items": {"type": "object", "required": ["seed", "arm", "genome_sha256", "e1", "e2", "probe", "snapshot", "leakage", "updates", "resources"]}},
    "contrasts": {"type": "array", "items": {"type": "object", "required": ["contrast", "metric", "gain_x_over_y", "ci_lo", "ci_hi", "seed_gains"]}}
  }
}
