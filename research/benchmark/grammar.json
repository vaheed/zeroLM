{
  "description": "Surface grammar for the ZeroLM Next benchmark generator. Written independently of model/next/spec.json: the generator composes sentences from this grammar and computes the gold semantics from the composition itself, never from the model.",
  "world": {"width": 8, "height": 8, "min_objects": 4, "max_objects": 7},
  "types": {"block": ["block", "cube", "box"], "circle": ["circle", "disc", "ball"], "triangle": ["triangle", "pyramid"], "star": ["star"]},
  "colors": ["red", "blue", "green", "yellow", "purple", "orange"],
  "directions": {"left": ["left", "leftward", "west"], "right": ["right", "rightward", "east"], "up": ["up", "upward", "north"], "down": ["down", "downward", "south"]},
  "verbs": {
    "move": {"imperative": ["move", "shift", "slide", "push"], "gerund": ["moving", "shifting", "sliding", "pushing"]},
    "paint": {"imperative": ["paint", "color", "recolor", "dye"], "gerund": ["painting"]},
    "remove": {"imperative": ["remove", "delete", "erase"], "gerund": ["removing", "deleting", "erasing"]}
  },
  "count_words": {"1": ["once", "one time", "1 time"], "2": ["twice", "two times", "2 times", "two steps"], "3": ["thrice", "three times", "3 times", "3 steps"],
                  "4": ["four times", "4 times", "four steps"], "5": ["five times", "5 times", "five cells"], "6": ["six times", "6 times"],
                  "7": ["seven times", "7 steps"], "8": ["eight times"], "9": ["nine times", "9 cells"]},
  "determiners": ["the", "a"],
  "negation": ["do not", "don't", "never"],
  "joiners": [", then ", " and then ", " and ", " then ", ". ", ", and then ", "; ", ", then, "],
  "dev_subset": {"types": ["block", "circle"], "colors": ["red", "blue", "green"], "verb_index": 0, "max_clauses": 3},
  "unsupported": {
    "unknown_verbs": ["fly", "throw", "jump", "rotate", "copy", "grow"],
    "unknown_types": ["hexagon", "robot", "table", "square"],
    "unknown_colors": ["pink", "teal", "black"],
    "unknown_directions": ["diagonally", "sideways", "backwards", "clockwise"],
    "chatter": ["hello", "what is the weather in Paris", "tell me a joke", "who are you", "explain your architecture", "thanks", "red", "block", "left", "then", "the", "", "...", "move", "paint the", "if", "not", "twice"]
  }
}
